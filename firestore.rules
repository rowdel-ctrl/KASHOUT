rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in, email-verified Google accounts that are on the allowlist get in.
    // The allowlist lives in the database (document config/allowlist, field "emails"),
    // not in this file, so no email address is ever committed to the repository.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/allowlist)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/allowlist).data.emails;
    }

    function validRecord(d) {
      return d.keys().hasOnly(['ref', 'amount', 'fee', 'name', 'number', 'txAt', 'savedAt', 'by', 'byUid', 'thumb'])
        && d.keys().hasAll(['ref', 'amount', 'fee', 'name', 'number', 'txAt', 'savedAt', 'by', 'byUid'])
        && d.ref is string && d.ref.size() <= 40
        && d.amount is number && d.amount > 0 && d.amount <= 1000000
        && d.fee is number && d.fee >= 0 && d.fee <= 100000
        && d.name is string && d.name.size() <= 80
        && d.number is string && d.number.size() <= 40
        && (d.txAt == null || d.txAt is number)
        && d.savedAt is number
        && d.by is string && d.by.size() <= 60
        && d.byUid == request.auth.uid
        && (!('thumb' in d) || (d.thumb is string && d.thumb.size() <= 60000));
    }

    // Nobody can read or change the allowlist from the app. Edit it in the Firebase console.
    match /config/{doc} {
      allow read, write: if false;
    }

    match /records/{id} {
      allow read: if allowed();
      // The first save of a reference uses the reference as the document id.
      // A second create with the same id is an update, which is denied below,
      // so two phones cannot both save the same reference.
      allow create: if allowed() && validRecord(request.resource.data);
      allow update: if false;
      // Only the person who saved a record can delete it (Undo and Delete).
      // Anyone on the list may delete a record older than one year (automatic cleanup).
      allow delete: if allowed()
        && (resource.data.byUid == request.auth.uid
            || resource.data.savedAt < request.time.toMillis() - 31536000000);
    }

    // The sharper receipt photo, one per record (same id as the record). Kept apart from the
    // record so the records list stays small and fast.
    match /photos/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['data', 'byUid', 'savedAt'])
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.savedAt is number
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 200000;
      allow update: if false;
      allow delete: if allowed()
        && (resource == null
            || resource.data.byUid == request.auth.uid
            || resource.data.savedAt < request.time.toMillis() - 31536000000);
    }

    // Shared app settings: the fee table, and the alert topic.
    match /shared/{doc} {
      allow read: if allowed();
      allow create, update: if allowed()
        && doc == 'settings'
        && request.resource.data.keys().hasOnly(['feeTable'])
        && request.resource.data.feeTable is list
        && request.resource.data.feeTable.size() > 0
        && request.resource.data.feeTable.size() <= 60;
      // The first phone creates the alert topic. It can never be changed after that.
      allow create: if allowed()
        && doc == 'alerts'
        && request.resource.data.keys().hasOnly(['topic'])
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 16
        && request.resource.data.topic.size() <= 64;
    }
  }
}
